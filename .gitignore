# Python bytecode and caches
__pycache__/
*.py[cod]
.pytest_cache/

# Virtual environments
.venv/
venv/

# Packaging artifacts
build/
dist/
*.egg-info/

# IDE and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Scratch artifacts; frozen pilot results are versioned for auditability.
artifacts/
results/*
!results/identifiability_pilot.csv
!results/identifiability_summary.csv
!results/identifiability_manifest.json
!results/figure1_identifiable_rate.png
!results/figure2_spectrum_error.png
!results/figure3_error_vs_condition.png
!results/figure4_sampler_variance.png

# Gate 3 keeps compressed raw evidence under version control; local expanded CSVs stay untracked.
results_step3/*_raw.csv
results_step3/*_raw.csv.gz

# Gate 4 publishes compressed long tables as verifiable parts.
results_step4/*.csv.gz
results_step4/development_raw.csv
results_step4/holdout_raw.csv
results_step4/unseen_raw.csv
results_step4/holdout_classified.csv
results_step4/unseen_classified.csv

# Gate 4-R corrected long evidence is published as deterministic parts.
results_step4r/*.csv.gz
results_step4r/development_raw.csv
results_step4r/holdout_raw.csv
results_step4r/unseen_raw.csv
results_step4r/holdout_classified.csv
results_step4r/unseen_classified.csv
